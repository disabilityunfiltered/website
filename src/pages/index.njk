---
layout: layouts/base.njk
permalink: /
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">An Australian podcast</p>
    <h1>{{ site.tagline }}</h1>
    <p class="hero-sub">We speak with people with disability, families, support workers and providers about the stories, challenges and ideas shaping disability support in Australia.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/episodes/">Browse episodes</a>
      <a class="btn btn-secondary" href="/follow/">Follow the show</a>
    </div>
  </div>
</section>

<section class="latest" aria-labelledby="latest-heading">
  <div class="wrap">
    <h2 id="latest-heading">Latest episodes</h2>
    {% set episodes = collections.episodes %}
    {% if episodes.length %}
      <div class="episode-grid">
        {% for episode in episodes.slice(0, 3) %}
          {% include "components/episode-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <p class="empty-state">First conversations are being recorded now. <a href="/follow/">Follow the show</a> to hear them first.</p>
    {% endif %}
  </div>
</section>

<section class="mission-strip">
  <div class="wrap">
    <p>Every guest is the expert on their own life. These conversations inform, connect and give people a stronger voice in how disability support works in Australia.</p>
  </div>
</section>

{% include "components/follow-strip.njk" %}
