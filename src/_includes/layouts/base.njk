<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | Real conversations from across the disability community{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta property="og:image" content="{{ site.url }}/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/social-icons.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/follow-strip.css">
  <link rel="stylesheet" href="/css/subscribe-form.css">
  <link rel="stylesheet" href="/css/episode-card.css">
  <link rel="stylesheet" href="/css/episode-reel.css">
  <link rel="stylesheet" href="/css/sponsor-strip.css">
  <link rel="stylesheet" href="/css/page.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "components/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
</body>
</html>
